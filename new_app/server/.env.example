# Copy to .env on the VPS. Do not commit the real .env.
NODE_ENV=production
PORT=3000
# Direct VPS/systemd deployment: 127.0.0.1. Docker sets this to 0.0.0.0 internally.
HOST=127.0.0.1
DATABASE_URL=postgresql://gym_api:CHANGE_ME@127.0.0.1:5432/gym_owner
# Keep false for a local PostgreSQL instance. Set true only for a remote DB with a trusted TLS certificate.
DATABASE_SSL=false
# Generate with: openssl rand -base64 48
JWT_SECRET=CHANGE_ME_WITH_A_LONG_RANDOM_VALUE
JWT_ISSUER=gym-owner-api
JWT_AUDIENCE=gym-owner-app
# Comma-separated public app origins. Native apps send no Origin header.
ALLOWED_ORIGINS=https://app.example.com
# Docker Compose only: generated by deploy/install-vps.sh. Keep both values secret.
POSTGRES_ADMIN_PASSWORD=CHANGE_ME
POSTGRES_APP_PASSWORD=CHANGE_ME
# Required only if Google sign-in remains enabled.
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
